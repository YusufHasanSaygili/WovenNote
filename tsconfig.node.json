{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
